TELEGRAM_BOT_TOKEN=
# Development only. Never set this on a public server.
ACADEMY_ALLOW_FOUNDER_PREVIEW=false
ACADEMY_DATABASE_URL=postgresql://academy_app:change-me@127.0.0.1:5432/academy
ACADEMY_PG_POOL_SIZE=5
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ACADEMY_PAYMENT_SUPPORT=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=20000
ACADEMY_STARS_MONTHLY=
# Accepted aliases for monthly: ACADEMY_STARS_MONTH, ACADEMY_STARS_30D, ACADEMY_STARS_30_DAYS
ACADEMY_STARS_QUARTERLY=
# Accepted aliases for quarterly: ACADEMY_STARS_QUARTER, ACADEMY_STARS_90D, ACADEMY_STARS_90_DAYS
ACADEMY_STARS_HALF_YEAR=
# Accepted aliases for half-year: ACADEMY_STARS_HALF_YEARLY, ACADEMY_STARS_180D, ACADEMY_STARS_180_DAYS
ACADEMY_STARS_YEARLY=
# Accepted aliases for yearly: ACADEMY_STARS_YEAR, ACADEMY_STARS_365D, ACADEMY_STARS_365_DAYS
ACADEMY_PUBLIC_BASE_URL=https://your-public-https-domain.example
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b
ACADEMY_CRON_SECRET=replace-with-a-long-random-secret
ACADEMY_MINI_APP_URL=https://your-local-https-tunnel.example
ACADEMY_UPLOAD_DIR=/var/lib/academy/uploads
ACADEMY_UPLOAD_MAX_BYTES=5242880
