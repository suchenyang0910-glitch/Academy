{
  "name": "academy-telegram-mini-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "acceptance:check": "node scripts/check-acceptance-static.mjs",
    "acceptance:new": "node scripts/create-acceptance-run.mjs",
    "acceptance:validate": "node scripts/validate-acceptance-run.mjs",
    "reminders:check": "node scripts/check-reminder-health.mjs",
    "seed:new": "node scripts/create-seed-validation-run.mjs",
    "seed:validate": "node scripts/validate-seed-validation-run.mjs",
    "deploy:preflight": "npm run build && npm run templates:check && npm run access:check && npm run content:quality:check && npm run content:i18n:check-copy && npm run db:check:schema && npm run acceptance:check",
    "deploy:check": "npm run build && npm run templates:check && npm run access:check && npm run content:quality:check && npm run content:i18n:check-copy && npm run db:check:schema && npm run acceptance:check && npm run db:migrate:postgres && npm run db:check:postgres",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "db:check:schema": "node scripts/check-schema-coverage.mjs",
    "access:check": "node scripts/check-access-gates.mjs",
    "db:check:postgres": "node scripts/check-postgres.mjs",
    "db:verify": "node scripts/verify-local.mjs",
    "db:import:sqlite": "node scripts/import-sqlite-to-postgres.mjs",
    "content:crawl:ai": "node scripts/crawl-ai-sources.mjs",
    "templates:check": "node scripts/check-template-design-guide.mjs",
    "content:quality:check": "node scripts/check-curriculum-quality.mjs",
    "content:i18n:template": "node scripts/generate-localization-template.mjs",
    "content:i18n:validate": "node scripts/validate-localization-draft.mjs",
    "content:i18n:check-copy": "node scripts/check-localized-copy.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
